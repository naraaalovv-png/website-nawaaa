 <!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Nawa for Nanatt ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Patrick+Hand&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:'Nunito',sans-serif;
    background:#fff8fb;
    color:#40383b;
}

/* NAVBAR */

nav{
    position:fixed;
    top:0;
    width:100%;
    padding:16px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(255,248,251,.9);
    backdrop-filter:blur(10px);
    z-index:100;
}

.logo{
    font-weight:800;
    color:#df8098;
}

nav a{
    text-decoration:none;
    color:#665c60;
    font-size:12px;
    margin-left:18px;
}

/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:100px 20px 50px;
    background:
        radial-gradient(circle at 10% 20%,#ffdce6,transparent 25%),
        radial-gradient(circle at 90% 80%,#eadcf5,transparent 25%),
        #fff8fb;
}

.hero-box{
    max-width:650px;
}

.sticker{
    display:inline-block;
    background:#ffe0e8;
    color:#c9657e;
    padding:8px 16px;
    border-radius:20px;
    font-size:12px;
    font-weight:700;
    transform:rotate(-3deg);
    margin-bottom:25px;
}

.hero h1{
    font-family:'Patrick Hand',cursive;
    font-size:72px;
    line-height:.95;
}

.hero h1 span{
    color:#df8098;
}

.hero p{
    margin-top:25px;
    color:#786e72;
    font-size:14px;
    line-height:1.8;
}

.btn{
    display:inline-block;
    margin-top:30px;
    padding:13px 25px;
    background:#df8098;
    color:white;
    border-radius:25px;
    text-decoration:none;
    font-size:13px;
    font-weight:700;
    box-shadow:0 6px 0 #c96b83;
    transition:.2s;
}

.btn:hover{
    transform:translateY(4px);
    box-shadow:0 2px 0 #c96b83;
}

/* SECTION */

section{
    padding:90px 8%;
}

.title{
    text-align:center;
    margin-bottom:45px;
}

.title h2{
    font-family:'Patrick Hand',cursive;
    font-size:45px;
}

.title p{
    color:#8b8084;
    font-size:13px;
    margin-top:5px;
}

/* NOTE */

.note-section{
    background:#fff;
}

.note{
    max-width:700px;
    margin:auto;
    background:#fffdfd;
    border:2px solid #f3d8e0;
    border-radius:22px;
    padding:35px;
    line-height:1.9;
    box-shadow:8px 8px 0 #f5d3dc;
    transform:rotate(-1deg);
}

.note .hello{
    font-family:'Patrick Hand',cursive;
    font-size:28px;
    color:#dc7991;
    margin-bottom:15px;
}

.note strong{
    color:#d96e87;
}

/* LITTLE THINGS */

.little{
    background:#fff0f4;
}

.cards{
    max-width:900px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    background:white;
    padding:30px 20px;
    border-radius:20px;
    text-align:center;
    border:2px solid #f4dce3;
    transition:.3s;
}

.card:hover{
    transform:translateY(-7px) rotate(-2deg);
}

.emoji{
    font-size:35px;
    margin-bottom:15px;
}

.card h3{
    font-size:17px;
    margin-bottom:10px;
}

.card p{
    font-size:13px;
    color:#81777b;
    line-height:1.7;
}

/* CHAT */

.chat-section{
    background:#fff;
}

.chat{
    max-width:600px;
    margin:auto;
}

.message{
    width:max-content;
    max-width:80%;
    padding:12px 17px;
    border-radius:18px;
    margin:12px 0;
    font-size:13px;
    line-height:1.5;
}

.left{
    background:#f2e9ec;
    border-bottom-left-radius:5px;
}

.right{
    background:#df8098;
    color:white;
    margin-left:auto;
    border-bottom-right-radius:5px;
}

.typing{
    color:#aaa;
    font-size:11px;
    margin-top:15px;
}

/* RANDOM */

.random{
    background:#f9edf7;
    text-align:center;
}

.random-box{
    max-width:650px;
    margin:auto;
}

.random-text{
    background:white;
    min-height:110px;
    padding:30px;
    border-radius:20px;
    border:2px dashed #dfb9ca;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:'Patrick Hand',cursive;
    font-size:25px;
    margin-bottom:20px;
}

.random button{
    border:none;
    background:#df8098;
    color:white;
    padding:12px 23px;
    border-radius:25px;
    cursor:pointer;
    font-weight:700;
}

/* LOVE METER */

.meter-section{
    background:#fff;
    text-align:center;
}

.meter{
    max-width:650px;
    margin:auto;
}

.bar{
    height:22px;
    background:#f1dce2;
    border-radius:20px;
    overflow:hidden;
    margin:25px 0 10px;
}

.fill{
    height:100%;
    width:98%;
    background:#df8098;
    border-radius:20px;
}

.percent{
    color:#d66f88;
    font-weight:800;
}

/* LAST */

.last{
    text-align:center;
    background:#fff0f4;
    min-height:70vh;
    display:flex;
    align-items:center;
    justify-content:center;
}

.last-box{
    max-width:600px;
}

.last h2{
    font-family:'Patrick Hand',cursive;
    font-size:55px;
}

.last p{
    margin-top:20px;
    color:#766c70;
    font-size:14px;
    line-height:1.9;
}

.signature{
    margin-top:35px;
    font-family:'Patrick Hand',cursive;
    font-size:28px;
    color:#d9768e;
}

/* FOOTER */

footer{
    background:#292426;
    color:#aaa;
    text-align:center;
    padding:30px;
    font-size:12px;
}

footer span{
    color:#f19aae;
    font-weight:700;
}

/* MOBILE */

@media(max-width:700px){

    nav{
        padding:15px 6%;
    }

    nav a{
        margin-left:8px;
        font-size:10px;
    }

    .hero h1{
        font-size:55px;
    }

    .cards{
        grid-template-columns:1fr;
    }

    section{
        padding:75px 7%;
    }

    .note{
        padding:28px;
    }

    .last h2{
        font-size:48px;
    }
}
</style>
</head>


<body>

<!-- NAVBAR -->

<nav>

    <div class="logo">
        for nanatt ♡
    </div>

    <div>
        <a href="#note">pesan</a>
        <a href="#little">tentang kamu</a>
        <a href="#random">random</a>
    </div>

</nav>


<!-- HERO -->

<section class="hero">

    <div class="hero-box">

        <div class="sticker">
            ⚠️ website khusus satu orang
        </div>

        <h1>
            hi,<br>
            <span>nanatt.</span>
        </h1>

        <p>
            sebenarnya nggak ada alasan khusus bikin website ini...
            <br>
            cuma pengen bilang sesuatu yang mungkin
            lebih enak ditulis daripada diomongin.
        </p>

        <a href="#note" class="btn">
            jangan langsung senyum ↓
        </a>

    </div>

</section>


<!-- NOTE -->

<section class="note-section" id="note">

    <div class="title">

        <h2>oke, serius bentar</h2>

        <p>
            walaupun cuma bentar ya 😭
        </p>

    </div>


    <div class="note">

        <div class="hello">
            hai nanatt,
        </div>

        <p>
            aku cuma mau bilang kalau
            <strong>aku bangga punya kamu.</strong>
        </p>

        <br>

        <p>
            mungkin aku nggak selalu bilang,
            mungkin kadang aku malah cuma diem,
            tapi bukan berarti aku nggak notice.
        </p>

        <br>

        <p>
            aku lihat usaha kamu,
            aku lihat kamu berkembang,
            dan aku lihat hal-hal kecil yang mungkin
            menurut kamu biasa aja.
        </p>

        <br>

        <p>
            dan jujur...
            punya seseorang yang bisa bikin aku
            merasa nyaman jadi diri sendiri itu
            ternyata seseru itu.
        </p>

        <br>

        <p>
            jadi kalau suatu saat kamu lagi ngerasa
            kurang, gagal, atau ngerasa nggak cukup,
            please inget satu hal:
        </p>

        <br>

        <p>
            <strong>
                ada seseorang yang tetap bangga sama kamu.
            </strong>
        </p>

    </div>

</section>


<!-- LITTLE THINGS -->

<section class="little" id="little">

    <div class="title">

        <h2>hal kecil tentang kamu</h2>

        <p>
            yang bikin aku makin suka punya kamu
        </p>

    </div>


    <div class="cards">

        <div class="card">

            <div class="emoji">
                🫵🏻
            </div>

            <h3>cara kamu jadi kamu</h3>

            <p>
                nggak perlu jadi orang lain.
                versi kamu yang sekarang aja
                udah aku suka.
            </p>

        </div>


        <div class="card">

            <div class="emoji">
                🫶🏻
            </div>

            <h3>cara kamu dengerin</h3>

            <p>
                hal kecil sih,
                tapi rasanya berarti banget
                waktu kamu mau dengerin aku.
            </p>

        </div>


        <div class="card">

            <div class="emoji">
                😭
            </div>

            <h3>cara kamu bikin nyaman</h3>

            <p>
                kadang nggak ngapa-ngapain,
                cuma ngobrol random aja
                udah bikin betah.
            </p>

        </div>

    </div>

</section>


<!-- CHAT -->

<section class="chat-section">

    <div class="title">

        <h2>percakapan random</h2>

        <p>
            nggak penting, tapi somehow penting
        </p>

    </div>


    <div class="chat">

        <div class="message left">
            "kamu tau nggak?"
        </div>

        <div class="message right">
            "tau apaan?"
        </div>

        <div class="message left">
            "aku bangga punya kamu."
        </div>

        <div class="message right">
            "ih apaan sih 😭"
        </div>

        <div class="message left">
            "yaudah gapapa, lanjut scroll."
        </div>

        <div class="typing">
            nanatt is typing...
        </div>

    </div>

</section>


<!-- RANDOM -->

<section class="random" id="random">

    <div class="title">

        <h2>random reminder ♡</h2>

        <p>
            pencet kalau lagi butuh diingetin
        </p>

    </div>


    <div class="random-box">

        <div class="random-text" id="randomText">
            pencet tombol di bawah dulu 👇🏻
        </div>

        <button onclick="randomMessage()">
            aku butuh reminder
        </button>

    </div>

</section>


<!-- LOVE METER -->

<section class="meter-section">

    <div class="title">

        <h2>tingkat kebanggaan</h2>

        <p>
            sumber: penelitian Nawa, sangat terpercaya
        </p>

    </div>


    <div class="meter">

        <div class="bar">

            <div class="fill"></div>

        </div>

        <div class="percent">
            98% — 2% lagi malu ngomongnya
        </div>

    </div>

</section>


<!-- LAST -->

<section class="last">

    <div class="last-box">

        <h2>
            last thing...
        </h2>

        <p>
            makasih ya udah hadir.<br>
            makasih udah jadi diri kamu sendiri.<br>
            dan makasih karena tanpa sadar,
            kamu udah jadi salah satu bagian
            favorit dari hari-hariku.
        </p>

        <p>
            nggak perlu jadi sempurna.
            nggak perlu selalu kuat.
            jadi kamu aja.
        </p>

        <div class="signature">
            ♡ — Nawa
        </div>

    </div>

</section>


<!-- FOOTER -->

<footer>

    made with a little love ♡
    <br><br>

    <span>Nawa for Nanatt</span>

</footer>


<script>

function randomMessage(){

    const messages = [

        "btw, aku bangga sama kamu. iya kamu. jangan bilang siapa-siapa 😭",

        "hari ini boleh capek. tapi jangan lupa, kamu udah sejauh ini.",

        "kalau kamu lagi ngerasa nggak cukup, sini aku yang bilang: kamu cukup.",

        "fun fact: ada seseorang yang seneng banget punya kamu. hint-nya Nawa.",

        "nggak harus selalu hebat kok. aku tetap bangga.",

        "jangan terlalu keras sama diri sendiri ya, Nanatt.",

        "aku nggak tau masa depan bakal gimana, tapi semoga kita tetap baik-baik.",

        "iya, website ini lebay dikit. tapi pesannya serius.",

        "proud of you. always. ♡"

    ];

    const random =
        messages[Math.floor(Math.random()*messages.length)];

    document.getElementById("randomText").innerText = random;

}

</script>

</body>
</html>
